{
  "name": "nestjs-validation-benchmark",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prepare": "ts-patch install",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "smoke": "node test/smoke.mjs",
    "microbenchmark": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/microbenchmark.js",
    "benchmark-class-validator": "k6 run test/benchmark.js -e VALIDATOR=class-validator -e RATE=100 -e DURATION=1m -e BASE_URL=http://127.0.0.1:3000",
    "benchmark-zod": "k6 run test/benchmark.js -e VALIDATOR=zod -e RATE=100 -e DURATION=1m -e BASE_URL=http://127.0.0.1:3000",
    "benchmark-typia": "k6 run test/benchmark.js -e VALIDATOR=typia -e RATE=100 -e DURATION=1m -e BASE_URL=http://127.0.0.1:3000"
  },
  "dependencies": {
    "@nestia/core": "11.3.4",
    "@nestia/fetcher": "11.3.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typia": "12.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-patch": "4.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
