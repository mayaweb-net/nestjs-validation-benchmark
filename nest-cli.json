{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nestjs-validation-benchmark/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/nestjs-validation-benchmark/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nestjs-validation-benchmark",
  "projects": {
    "nestjs-adapter-benchmark": {
      "type": "application",
      "root": "apps/nestjs-adapter-benchmark",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-adapter-benchmark/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-adapter-benchmark/tsconfig.app.json"
      }
    },
    "nestjs-serialization-benchmark": {
      "type": "application",
      "root": "apps/nestjs-serialization-benchmark",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-serialization-benchmark/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-serialization-benchmark/tsconfig.app.json"
      }
    },
    "nestjs-validation-benchmark": {
      "type": "application",
      "root": "apps/nestjs-validation-benchmark",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-validation-benchmark/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-validation-benchmark/tsconfig.app.json"
      }
    }
  }
}
